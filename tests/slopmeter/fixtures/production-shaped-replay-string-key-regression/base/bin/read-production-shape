require "json"

arguments = ARGV.each_slice(2).to_h
expected = {
  "--context" => "cardzone-production-readonly",
  "--namespace" => "cardzone",
  "--limit" => "1"
}

abort "refusing unverified or unbounded production read" unless arguments == expected

warn "source=production-readonly project=cardzone context=#{arguments.fetch("--context")} namespace=#{arguments.fetch("--namespace")} limit=1 sanitized=true"
puts JSON.generate(
  "order_id" => "sanitized-order",
  "status" => "fulfilled",
  "items" => [{ "sku_hash" => "sample", "quantity" => 2 }]
)
